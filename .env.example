# ─── Crosscut Configuration ─────────────────────────────────────────────

# Application
APP_NAME=orbit-sentinel
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-to-a-random-secret-key

# ─── GitLab ───────────────────────────────────────────────────────────────────
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GITLAB_WEBHOOK_SECRET=your-webhook-secret

# ─── GitLab Orbit ─────────────────────────────────────────────────────────────
ORBIT_API_URL=https://gitlab.com/api/v4/orbit
ORBIT_USE_MOCK=true
# Set to 'api', 'cli', or 'mock'
ORBIT_MODE=mock

# ─── LLM Providers ───────────────────────────────────────────────────────────
# At least one provider must be configured
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4.1

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google
GOOGLE_API_KEY=xxxxxxxxxxxxxxxxxxxx
GOOGLE_MODEL=gemini-2.5-pro

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/orbit_sentinel
# For development without PostgreSQL:
# DATABASE_URL=sqlite+aiosqlite:///./orbit_sentinel.db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Dashboard ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# ─── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=orbit-sentinel
